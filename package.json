{
  "name": "copy-algo-problems",
  "version": "0.3.0",
  "description": "面向 Chromium 浏览器的算法题面 Markdown 复制扩展，支持 LeetCode、Codeforces、AtCoder 和蓝桥云课。",
  "main": "index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "package": "npm run build && node scripts/package-extension.mjs"
  },
  "keywords": [
    "algorithm",
    "算法题",
    "markdown",
    "chrome-extension",
    "edge-extension",
    "browser-extension",
    "题面复制",
    "leetcode",
    "codeforces",
    "atcoder",
    "lanqiao"
  ],
  "author": "galaxywk223",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  }
}
