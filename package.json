{
  "name": "copy-algo-problems",
  "version": "0.2.0",
  "description": "Chromium extension for copying LeetCode, Codeforces, and Lanqiao problems as Markdown.",
  "main": "index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "package": "npm run build && node scripts/package-extension.mjs"
  },
  "keywords": [
    "algorithm",
    "markdown",
    "chrome-extension",
    "edge-extension",
    "leetcode",
    "codeforces",
    "lanqiao"
  ],
  "author": "galaxywk223",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  }
}
